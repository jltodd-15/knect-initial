require_relative '../node_modules/react-native/scripts/react_native_pods'

$RNFirebaseDisableSPM = true

platform :ios, '15.1'
install! 'cocoapods', :deterministic_uuids => false

target 'Knect' do
  config = use_native_modules!

  # Static frameworks: one of react-native-firebase's two supported linkage modes
  # once SPM is disabled (see $RNFirebaseDisableSPM above). Needed for Firestore's
  # gRPC dependency, which doesn't generate a correct module map under plain
  # static libraries + scoped modular_headers.
  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Temporary fix for Xcode consteval strictness breaking fmt and folly.
    # Must run after react_native_post_install, which forces c++20 project-wide.
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt' || target.name == 'RCT-Folly'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
    installer.pods_project.save
  end
end