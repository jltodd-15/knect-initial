    "yellow": {
      "base": "#eab308",
      "solid": "#a16207",
      "textOnBase": "#0d0d12",
      "textOnSolid": "#ffffff",
      "proposedFill": "#eab30814",
      "proposedBorder": "#eab308"
    }
  },
  "eventRules": {
    "confirmed_or_personal": "fill = solid (700), text = #ffffff, both themes",
    "proposed": "2px dashed border = base, fill = base at 8% (proposedFill), text = text-strong",
    "cancelled_expired": "surface + border, text-secondary, title struck through, tag",
    "free": "renders the same as busy; Free is only shown in the detail view",
    "swatch": "base"
  },
  "type": {
    "display": {
      "size": 32,
      "weight": 800,
      "letterSpacing": -0.8,
      "use": "Screen titles: Planner, Discover"
    },
    "title": {
      "size": 24,
      "weight": 800,
      "letterSpacing": -0.4,
      "use": "Event detail title"
    },
    "headline": {
      "size": 20,
      "weight": 800,
      "letterSpacing": -0.3,
      "use": "Title input, big card names"
    },
    "nav-title": {
      "size": 17,
      "weight": 800,
      "letterSpacing": 0,
      "use": "Sheet/nav titles, card titles"
    },
    "button": {
      "size": 16,
      "weight": 800,
      "letterSpacing": 0,
      "use": "Primary buttons"
    },
    "body": {
      "size": 16,
      "weight": 400,
      "letterSpacing": 0,
      "use": "Inputs, message text"
    },
    "body-sm": {
      "size": 15,
      "weight": 500,
      "letterSpacing": 0,
      "use": "Row labels and values"
    },
    "label": {
      "size": 14,
      "weight": 700,
      "letterSpacing": 0,
      "use": "Chips, small buttons, day numbers"
    },
    "caption": {
      "size": 13,
      "weight": 500,
      "letterSpacing": 0,
      "use": "Sublines, event block titles"
    },
    "footnote": {
      "size": 12,
      "weight": 500,
      "letterSpacing": 0,
      "use": "Timestamps, hour labels, legends"
    },
    "micro": {
      "size": 11,
      "weight": 800,
      "letterSpacing": 0,
      "use": "Tags (Vote open), event sublines"
    },
    "avatar": {
      "size": 10,
      "weight": 800,
      "letterSpacing": 0,
      "use": "Initials in small avatars"
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "base": 16,
    "lg": 20,
    "xl": 24,
    "2xl": 32
  },
  "radius": {
    "sm": 8,
    "event": 10,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "size": {
    "hour-height": 48,
    "button-height": 52,
    "row-height": 52,
    "touch-min": 44,
    "tab-bar-height": 84,
    "avatar-sm": 26,
    "avatar-md": 32,
    "snap-minutes": 15
