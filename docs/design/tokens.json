  "eventColors": {
    "emerald": {
      "base": "#10b981",
      "solid": "#047857",
      "textOnBase": "#0d0d12",
      "textOnSolid": "#ffffff",
      "proposedFill": "#10b98114",
      "proposedBorder": "#10b981"
    },
    "blue": {
      "base": "#3b82f6",
      "solid": "#1d4ed8",
      "textOnBase": "#0d0d12",
      "textOnSolid": "#ffffff",
      "proposedFill": "#3b82f614",
      "proposedBorder": "#3b82f6"
    },
    "violet": {
      "base": "#8b5cf6",
      "solid": "#6d28d9",
      "textOnBase": "#0d0d12",
      "textOnSolid": "#ffffff",
      "proposedFill": "#8b5cf614",
      "proposedBorder": "#8b5cf6"
    },
    "pink": {
      "base": "#ec4899",
      "solid": "#be185d",
      "textOnBase": "#0d0d12",
      "textOnSolid": "#ffffff",
      "proposedFill": "#ec489914",
      "proposedBorder": "#ec4899"
    },
    "orange": {
      "base": "#f97316",
      "solid": "#c2410c",
      "textOnBase": "#0d0d12",
      "textOnSolid": "#ffffff",
      "proposedFill": "#f9731614",
      "proposedBorder": "#f97316"
