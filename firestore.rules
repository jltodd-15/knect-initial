rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow admins to read and write all documents
    match /{document=**} {
      allow read, write: if hasAnyRole(["ADMIN", "OWNER"]);
    }

    // Rowy: Allow signed in users to read Rowy configuration and admins to write
    match /_rowy_/{docId} {
      allow read: if request.auth.token.roles.size() > 0;
      allow write: if hasAnyRole(["ADMIN", "OWNER"]);
    	match /{document=**} {
        allow read: if request.auth.token.roles.size() > 0;
        allow write: if hasAnyRole(["ADMIN", "OWNER"]);
      }
    }
    // Rowy: Allow users to edit their settings
    match /_rowy_/userManagement/users/{userId} {
      allow get, update, delete: if isDocOwner(userId);
      allow create: if request.auth.token.roles.size() > 0;
    }
    // Rowy: Allow public to read public Rowy configuration
    match /_rowy_/publicSettings {
      allow get: if true;
    }

    // Rowy: Utility functions
    function isDocOwner(docId) {
      return request.auth != null && (request.auth.uid == resource.id || request.auth.uid == docId);
    }
    function hasAnyRole(roles) {
      return request.auth != null && request.auth.token.roles.hasAny(roles);
    }

    // Knect: shared helpers
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // True when an integer counter moved by exactly `step`. A counter the document does not
    // have yet counts from zero. Removing the field, or writing a non-integer, is false.
    function steppedBy(field, step) {
      return field in request.resource.data
        && request.resource.data[field] is int
        && request.resource.data[field] - resource.data.get(field, 0) == step;
    }
    // True when `uid` has the signed-in user in their blocked_users. Rules can read
    // Private_info here even though no other client can.
    function hasBlockedMe(uid) {
      return exists(/databases/$(database)/documents/Users/$(uid)/Private_info/main)
        && request.auth.uid in get(/databases/$(database)/documents/Users/$(uid)/Private_info/main)
             .data.get('blocked_users', []);
    }

    // Knect: the user tree. The document ID is the Auth UID, so ownership is a string
    // comparison. Every block splits delete from create/update: request.resource is null on a
    // delete, so a field check there would deny every delete with a null-reference error.

    // Readable by every signed-in user, so nothing private may live on this document.
    match /Users/{userId} {
      allow read: if signedIn();

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly([
             'name', 'name_lowercase', 'profile_info', 'profile_picture_url',
             'interests', 'current_status', 'status_visibility', 'status_expires_at'
           ]);

      allow delete: if isUser(userId);
    }

    // The document ID is pinned to the literal `main`: a write to any other ID is denied rather
    // than creating a second document nothing reads.
    match /Users/{userId}/Private_info/main {
      allow read: if isUser(userId);

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly([
             'location', 'geohash', 'email', 'blocked_users', 'fcm_tokens',
             'external_calendar_tokens', 'tag_affinity_scores',
             'tag_scores_last_decayed', 'liked_activity_ids'
           ]);

      allow delete: if isUser(userId);
    }

    // Read is open to any signed-in user on purpose: a block says only that you are busy. If a
    // title, a location or a linked event is ever added here, that decision has to be reopened.
    match /Users/{userId}/Free_Busy/{blockId} {
      allow read: if signedIn();

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['start_time', 'end_time']);

      allow delete: if isUser(userId);
    }

    match /Users/{userId}/Friends/{friendId} {
      allow read: if signedIn();

      // Creating an entry: in your own doc you may only claim you sent a request.
      // In someone else's doc you may only claim you are requesting them, and not at all if
      // they have blocked you. A declined request (a deleted entry) can be sent again; only
      // an active block stops it.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['status'])
        && (
             (request.auth.uid == userId   && request.resource.data.status == 'request_sent')
          || (request.auth.uid == friendId && request.resource.data.status == 'pending'
              && !hasBlockedMe(userId))
           );

      // Owner-only by ruling, not by omission: accepting a request runs through the
      // acceptFriendRequest Cloud Function, never through a client write to the other
      // person's document.
      //
      // FOR LATER TICKETS: because of this, a user can set their OWN copy to "friend" or
      // "close_friend" without the other person agreeing. A user's own Friends document
      // therefore proves nothing. Any rule or Function that grants access because two people
      // are friends (chats, events, free/busy) must check the OTHER person's document,
      // Users/{other}/Friends/{requester}, never the requester's own.
      allow update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'request_sent', 'friend', 'close_friend'];

      allow delete: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId);
    }

    match /Users/{userId}/Activity_History/{historyId} {
      allow read: if isUser(userId);

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['activity_reference', 'tapped_ads']);

      allow delete: if isUser(userId);
    }

    match /Users/{userId}/Liked_Activities/{activityId} {
      allow read: if isUser(userId);

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['saved_at']);

      allow delete: if isUser(userId);
    }

    // Knect: Activities. Write access is gated on `source`, which every Activity has, rather
    // than on `creator_id`, which seeded activities lack. Seeded activities cannot be edited
    // from inside the app at all.
    match /Activities/{activityId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.source == "user_generated"
        && request.auth.uid == request.resource.data.creator_id
        && request.resource.data.keys().hasOnly([
             'name', 'description', 'cost', 'source', 'creator_id', 'category',
             'tags', 'pictures', 'location', 'geohash', 'is_location_based',
             'click_count', 'likes', 'created_at'
           ]);

      // The creator may edit their own activity, but not who owns it, where it came from, or
      // its like count.
      //
      // IF `saves` OR `sends` COUNTERS ARE EVER ADDED: add them to the hasAny list here so a
      // creator cannot set them, and to the counter clause below (its hasOnly list plus a
      // steppedBy line each) so everyone else can only move them one step at a time.
      allow update: if signedIn()
        && resource.data.source == "user_generated"
        && request.auth.uid == resource.data.creator_id
        && !changedKeys().hasAny(['creator_id', 'source', 'likes']);

      allow delete: if signedIn()
        && resource.data.source == "user_generated"
        && request.auth.uid == resource.data.creator_id;

      // Any signed-in user may move the engagement counters, and nothing else, one step at a
      // time: click_count by +1; likes by +1 or -1, never below zero.
      allow update: if signedIn()
        && changedKeys().hasOnly(['click_count', 'likes'])
        && (!changedKeys().hasAny(['click_count']) || steppedBy('click_count', 1))
        && (!changedKeys().hasAny(['likes'])
            || steppedBy('likes', 1)
            || (steppedBy('likes', -1) && request.resource.data.likes >= 0));
    }
  }
}
