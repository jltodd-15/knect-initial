rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow admins to read and write all documents
    match /{document=**} {
      allow read, write: if hasAnyRole(["ADMIN", "OWNER"]);
    }

    // Rowy: Allow signed in users to read Rowy configuration and admins to write
    match /_rowy_/{docId} {
      allow read: if request.auth.token.roles.size() > 0;
      allow write: if hasAnyRole(["ADMIN", "OWNER"]);
    	match /{document=**} {
        allow read: if request.auth.token.roles.size() > 0;
        allow write: if hasAnyRole(["ADMIN", "OWNER"]);
      }
    }
    // Rowy: Allow users to edit their settings
    match /_rowy_/userManagement/users/{userId} {
      allow get, update, delete: if isDocOwner(userId);
      allow create: if request.auth.token.roles.size() > 0;
    }
    // Rowy: Allow public to read public Rowy configuration
    match /_rowy_/publicSettings {
      allow get: if true;
    }

    // Rowy: Utility functions
    function isDocOwner(docId) {
      return request.auth != null && (request.auth.uid == resource.id || request.auth.uid == docId);
    }
    function hasAnyRole(roles) {
      return request.auth != null && request.auth.token.roles.hasAny(roles);
    }

    // Knect: shared helpers
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // True when an integer counter moved by exactly `step`. A counter the document does not
    // have yet counts from zero. Removing the field, or writing a non-integer, is false.
    function steppedBy(field, step) {
      return field in request.resource.data
        && request.resource.data[field] is int
        && request.resource.data[field] - resource.data.get(field, 0) == step;
    }
    // True when `uid` has the signed-in user in their blocked_users. Rules can read
    // Private_info here even though no other client can.
    function hasBlockedMe(uid) {
      return exists(/databases/$(database)/documents/Users/$(uid)/Private_info/main)
        && request.auth.uid in get(/databases/$(database)/documents/Users/$(uid)/Private_info/main)
             .data.get('blocked_users', []);
    }

    // Knect: the user tree. The document ID is the Auth UID, so ownership is a string
    // comparison. Every block splits delete from create/update: request.resource is null on a
    // delete, so a field check there would deny every delete with a null-reference error.

    // Readable by every signed-in user, so nothing private may live on this document.
    match /Users/{userId} {
      allow read: if signedIn();

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly([
             'name', 'name_lowercase', 'profile_info', 'profile_picture_url',
             'interests', 'current_status', 'status_visibility', 'status_expires_at'
           ]);

      allow delete: if isUser(userId);
    }

    // The document ID is pinned to the literal `main`: a write to any other ID is denied rather
    // than creating a second document nothing reads.
    match /Users/{userId}/Private_info/main {
      allow read: if isUser(userId);

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly([
             'location', 'geohash', 'email', 'blocked_users', 'fcm_tokens',
             'external_calendar_tokens', 'tag_affinity_scores',
             'tag_scores_last_decayed', 'liked_activity_ids'
           ]);

      allow delete: if isUser(userId);
    }

    // Read is open to any signed-in user on purpose: a block says only that you are busy. If a
    // title, a location or a linked event is ever added here, that decision has to be reopened.
    match /Users/{userId}/Free_Busy/{blockId} {
      allow read: if signedIn();

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['start_time', 'end_time']);

      allow delete: if isUser(userId);
    }

    match /Users/{userId}/Friends/{friendId} {
      allow read: if signedIn();

      // Creating an entry: in your own doc you may only claim you sent a request.
      // In someone else's doc you may only claim you are requesting them, and not at all if
      // they have blocked you. A declined request (a deleted entry) can be sent again; only
      // an active block stops it.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['status'])
        && (
             (request.auth.uid == userId   && request.resource.data.status == 'request_sent')
          || (request.auth.uid == friendId && request.resource.data.status == 'pending'
              && !hasBlockedMe(userId))
           );

      // Owner-only by ruling, not by omission: accepting a request runs through the
      // acceptFriendRequest Cloud Function, never through a client write to the other
      // person's document.
      //
      // FOR LATER TICKETS: because of this, a user can set their OWN copy to "friend" or
      // "close_friend" without the other person agreeing. A user's own Friends document
      // therefore proves nothing. Any rule or Function that grants access because two people
      // are friends (chats, events, free/busy) must check the OTHER person's document,
      // Users/{other}/Friends/{requester}, never the requester's own.
      allow update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'request_sent', 'friend', 'close_friend'];

      allow delete: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId);
    }

    match /Users/{userId}/Activity_History/{historyId} {
      allow read: if isUser(userId);

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['activity_reference', 'tapped_ads']);

      allow delete: if isUser(userId);
    }

    match /Users/{userId}/Liked_Activities/{activityId} {
      allow read: if isUser(userId);

      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['saved_at']);

      allow delete: if isUser(userId);
    }

    // Knect: Activities. Write access is gated on `source`, which every Activity has, rather
    // than on `creator_id`, which seeded activities lack. Seeded activities cannot be edited
    // from inside the app at all.
    match /Activities/{activityId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.source == "user_generated"
        && request.auth.uid == request.resource.data.creator_id
        && request.resource.data.keys().hasOnly([
             'name', 'description', 'cost', 'source', 'creator_id', 'category',
             'tags', 'pictures', 'location', 'geohash', 'is_location_based',
             'click_count', 'likes', 'created_at'
           ])
        // Counters start at zero (or absent, which counts as zero).
        && request.resource.data.get('click_count', 0) == 0
        && request.resource.data.get('likes', 0) == 0;

      // The creator may edit their own activity, but not who owns it, where it came from, or
      // its counters. (The counter clause below still lets them like or open it like anyone.)
      //
      // IF `saves` OR `sends` COUNTERS ARE EVER ADDED: add them in three places. The hasAny
      // list here, so a creator cannot set them. The zero check on create above. And the
      // counter clause below (its hasOnly list plus a steppedBy line each), so everyone can
      // only move them one step at a time.
      allow update: if signedIn()
        && resource.data.source == "user_generated"
        && request.auth.uid == resource.data.creator_id
        && !changedKeys().hasAny(['creator_id', 'source', 'likes', 'click_count']);

      allow delete: if signedIn()
        && resource.data.source == "user_generated"
        && request.auth.uid == resource.data.creator_id;

      // Any signed-in user may move the engagement counters, and nothing else, one step at a
      // time: click_count by +1; likes by +1 or -1, never below zero.
      allow update: if signedIn()
        && changedKeys().hasOnly(['click_count', 'likes'])
        && (!changedKeys().hasAny(['click_count']) || steppedBy('click_count', 1))
        && (!changedKeys().hasAny(['likes'])
            || steppedBy('likes', 1)
            || (steppedBy('likes', -1) && request.resource.data.likes >= 0));
    }

    // Knect: the trust boundary for chats, votes and events. Anything a client can write, a
    // client can lie about. So everything that decides an outcome (event status other than an
    // owner's cancel, every vote result field, every chat preview field) has no client clause
    // at all and is written only by the Admin SDK. Don't add one.
    //
    // User-owned state in a shared document is a map keyed by UID (ballots, RSVPs), and a
    // participant may write only their own key. A missing map counts as empty.

    // True when the only change to `field`, a UID-keyed map, is the signed-in user's own key.
    function onlyOwnKey(field) {
      return request.resource.data.get(field, {})
        .diff(resource.data.get(field, {}))
        .affectedKeys().hasOnly([request.auth.uid]);
    }

    // BLOCKING IS NOT ENFORCED BY ANY RULE BELOW, and must never be described as enforced.
    // blocked_users lives in Private_info, which only its owner can read, so checking it per
    // message would need a new readable block record and a billed get() on every send. Ruled
    // for MVP: 15.2's receive-side filter is the protection. A blocked user's messages are still
    // created, stored and delivered, then hidden. Revisit if reporting (13.3) needs a
    // server-side record of who blocked whom.

    // Additions to participants are unconstrained (15.1's add-member); removals are limited to
    // leaving. participant_hash and chat_origin are set at creation only, and the recent_message
    // preview fields are Admin-SDK-only.
    //
    // No delete clause. The old published rule had none either, so this is inherited rather
    // than decided; whether chats should be deletable is still an open question from 15.1.
    match /Chats/{chatId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.keys().hasOnly([
             'participants', 'participant_hash', 'chat_origin', 'chat_name'
           ]);

      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && changedKeys().hasOnly(['chat_name', 'participants'])
        && (!changedKeys().hasAny(['participants']) || onlyRemovedSelf());

      // Anyone dropped from participants must be the signed-in user.
      function onlyRemovedSelf() {
        return resource.data.participants
          .removeAll(request.resource.data.participants)
          .hasOnly([request.auth.uid]);
      }

      // Chat-scoped documents are secured by membership in the parent chat, at the cost of one
      // get() on Chats/{chatId}.
      function inChat() {
        return signedIn() && request.auth.uid
          in get(/databases/$(database)/documents/Chats/$(chatId)).data.participants;
      }

      // The only edit is a tombstone: clear the text, stamp the server time. There is no delete
      // clause because a message is never deleted. deleted_at is absent from the create list,
      // so a message cannot be born a tombstone.
      //
      // "system" is missing from message_type on purpose: nothing writes it yet. The ticket that
      // writes system messages widens the list. Values only, not shape: a proposal or vote
      // message pointing at nothing is not rejected, it renders as a broken card.
      match /Messages/{messageId} {
        allow read: if inChat();

        // A card message may leave text out; a missing text counts as empty. The 2,000-
        // character cap is enforced here, not only in the input field.
        allow create: if inChat()
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.get('text', '').size() <= 2000
          && request.resource.data.message_type in ['text', 'activity', 'event_proposal', 'vote']
          && request.resource.data.keys().hasOnly([
               'sender_id', 'text', 'timestamp', 'message_type',
               'activity_id', 'event_title', 'event_id', 'vote_id'
             ]);

        allow update: if signedIn()
          && request.auth.uid == resource.data.sender_id
          && changedKeys().hasOnly(['text', 'deleted_at'])
          && request.resource.data.text == ''
          && request.resource.data.deleted_at == request.time;
      }

      // status "closed", winning_option_id, closed_at, close_reason and final_counts have no
      // client clause, on create or update. That omission is what makes every result in the
      // app trustworthy: 17.2's tally writes them with the Admin SDK. No delete clause.
      match /Votes/{voteId} {
        allow read: if inChat();

        // Born open, at revision 1, attributed to its creator, with no ballots cast.
        allow create: if inChat()
          && request.resource.data.status == 'open'
          && request.resource.data.options_revision == 1
          && request.resource.data.created_by == request.auth.uid
          && request.resource.data.get('normal_votes', {}).size() == 0
          && request.resource.data.get('ranked_votes', {}).size() == 0
          && request.resource.data.keys().hasOnly([
               'created_by', 'linked_event_id', 'vote_scope', 'vote_type', 'status',
               'created_at', 'resolves_at', 'question', 'options', 'options_revision',
               'proposed_start_time', 'proposed_end_time', 'normal_votes', 'ranked_votes'
             ]);

        // A participant may write their own ballot, and only their own, while the vote is open.
        allow update: if inChat()
          && resource.data.status == 'open'
          && changedKeys().hasOnly(['normal_votes'])
          && onlyOwnKey('normal_votes');

        allow update: if inChat()
          && resource.data.status == 'open'
          && changedKeys().hasOnly(['ranked_votes'])
          && onlyOwnKey('ranked_votes');

        // Options may be appended, one at a time. Never edited, never removed: every option_id
        // is already referenced by cast ballots.
        allow update: if inChat()
          && resource.data.status == 'open'
          && changedKeys().hasOnly(['options', 'options_revision'])
          && request.resource.data.options.size() == resource.data.options.size() + 1
          && request.resource.data.options[0:resource.data.options.size()] == resource.data.options
          && request.resource.data.options_revision == resource.data.options_revision + 1;

        // status → cancelled, by whoever opened the vote, only while it is open. Whether a cancel
        // button exists, and what close_reason a cancelled vote holds, are 17.2's to decide.
        allow update: if inChat()
          && request.auth.uid == resource.data.created_by
          && changedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled'
          && resource.data.status == 'open';
      }
    }

    // Replaces the old Calendars collection, which has no rule and so is closed to every client.
    // Each update clause requires its own field to actually change: hasOnly alone lets a write
    // that changes nothing through.
    // Secured by membership in shared_with, with no owner fallback: an owner absent from their
    // own shared_with cannot read the event (see events.test.ts).
    //
    // "confirmed", "expired", confirmed_participants and applying a winning alternative are
    // Admin-SDK-only. Losing candidates are deleted by the Admin SDK too. No client deletes an
    // event: it is cancelled instead.
    match /Events/{eventId} {
      // Born undecided: proposed or candidate, with no confirmed_participants and no RSVP but
      // the owner's own.
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid
        && request.resource.data.status in ['proposed', 'candidate']
        && request.resource.data.get('rsvps', {}).keys().hasOnly([request.auth.uid])
        && request.resource.data.keys().hasOnly([
             'owner_id', 'shared_with', 'rsvps', 'event_time', 'end_time', 'created_at',
             'resolves_at', 'activity_id', 'event_title', 'activity_picture_url', 'status',
             'linked_vote_id', 'linked_chat_id', 'color', 'is_allday', 'location_text', 'source'
           ]);

      allow read: if signedIn() && request.auth.uid in resource.data.shared_with;

      // RSVPs: your own key only, in three windows.
      //   event_time has passed          → denied, every time
      //   "proposed", event still ahead  → write and change your key freely
      //   resolved, event still ahead    → only while your key holds "pending": answer once
      // This reads event_time, which is why 16.1 disables drag and resize on proposed events.
      allow update: if signedIn()
        && request.auth.uid in resource.data.shared_with
        && changedKeys().hasOnly(['rsvps'])
        && changedKeys().hasAny(['rsvps'])
        && onlyOwnKey('rsvps')
        && resource.data.event_time > request.time
        && (
             resource.data.status == 'proposed'
             || resource.data.get('rsvps', {}).get(request.auth.uid, null) == 'pending'
           );

      // shared_with: any participant of the linked chat. Errors, and so denies, when the event
      // has no linked_chat_id; 17.1's candidate events need one for this to work.
      allow update: if signedIn()
        && changedKeys().hasOnly(['shared_with'])
        && changedKeys().hasAny(['shared_with'])
        && request.auth.uid in get(
             /databases/$(database)/documents/Chats/$(resource.data.linked_chat_id)
           ).data.participants;

      // status → cancelled, by the owner, from a non-terminal state.
      allow update: if signedIn()
        && request.auth.uid == resource.data.owner_id
        && changedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled'
        && resource.data.status in ['proposed', 'confirmed'];
    }
  }
}
